{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inner Compass Affirmation Candidate",
  "type": "object",
  "required": [
    "affirmation_id",
    "category_id",
    "text",
    "source_record_ids",
    "review_status"
  ],
  "properties": {
    "affirmation_id": {
      "type": "string",
      "pattern": "^AFF-[0-9]{2}-[A-Z0-9-]+$"
    },
    "category_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "philosophical_theme": {
      "type": [
        "string",
        "null"
      ]
    },
    "tradition_basis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "category_fit_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "review_status": {
      "enum": [
        "DRAFT",
        "SOURCE_LINKED",
        "CATEGORY_VERIFIED",
        "APPROVED",
        "REJECTED"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
