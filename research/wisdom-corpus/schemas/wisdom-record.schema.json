{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inner Compass Wisdom Research Record",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "category_ids",
    "tradition",
    "author_or_attributed_figure",
    "work",
    "source_id",
    "problem_signals",
    "negative_match_signals",
    "source_confidence",
    "category_fit_score",
    "context_fit_score",
    "review_status"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^WIS-[A-Z0-9-]+$"
    },
    "record_type": {
      "enum": [
        "VERIFIED_DIRECT_QUOTE",
        "SOURCE_PARAPHRASE"
      ]
    },
    "category_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 25
      }
    },
    "related_category_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 25
      }
    },
    "problem_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_match_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existential_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "philosophical_themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradition": {
      "type": "string"
    },
    "school_or_lineage": {
      "type": [
        "string",
        "null"
      ]
    },
    "author_or_attributed_figure": {
      "type": "string"
    },
    "work": {
      "type": "string"
    },
    "book_chapter_section": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_language_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "translator": {
      "type": [
        "string",
        "null"
      ]
    },
    "edition": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_year": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "source_id": {
      "type": "string"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bibliographic_citation": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_status": {
      "enum": [
        "PUBLIC_DOMAIN",
        "OPEN_LICENSE",
        "LICENSED_OR_PERMISSIONED",
        "CITATION_ONLY",
        "REVIEW_REQUIRED"
      ]
    },
    "quote_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "teaching_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "translation_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_integrity_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "safety_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieval_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieval_phrases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradiction_or_boundary_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "category_fit_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "context_fit_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "review_status": {
      "enum": [
        "DRAFT",
        "SOURCE_VERIFIED",
        "CONTEXT_VERIFIED",
        "RIGHTS_VERIFIED",
        "CATEGORY_VERIFIED",
        "APPROVED",
        "REJECTED"
      ]
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_date": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "VERIFIED_DIRECT_QUOTE"
          }
        }
      },
      "then": {
        "required": [
          "quote_text",
          "translator",
          "edition",
          "book_chapter_section",
          "bibliographic_citation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "SOURCE_PARAPHRASE"
          }
        }
      },
      "then": {
        "required": [
          "teaching_summary"
        ]
      }
    }
  ],
  "additionalProperties": false
}
