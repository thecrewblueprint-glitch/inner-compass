{
  "name": "inner-compass",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "audit:wisdom": "python3 tools/eval/audit_wisdom_corpus.py",
    "audit:deterministic": "python3 tools/eval/check_deterministic_only_policy.py",
    "audit:reads": "python3 tools/eval/audit_reading_directory.py",
    "audit:safety": "tsx tools/eval/safety_matrix.ts",
    "audit:release": "python3 tools/eval/audit_release_readiness.py"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.87.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-native": "^0.73.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
