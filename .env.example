# Native application identifiers are owner-supplied before production builds.
EXPO_IOS_BUNDLE_ID=
EXPO_ANDROID_PACKAGE=

# Paths to locally supplied Firebase native configuration files.
GOOGLE_SERVICE_INFO_PLIST=
GOOGLE_SERVICES_JSON=

# Local emulator settings; safe to expose to the client.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Backend values live in Firebase Functions configuration / Secret Manager:
# OPENROUTER_API_KEY
# OPENROUTER_MODEL_ID
# GUIDANCE_RATE_LIMIT_PER_HOUR
