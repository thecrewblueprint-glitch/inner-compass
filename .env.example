# Default: deterministic-only production behavior.
# Set to "openrouter_free" to enable optional server-side AI phrasing.
INNER_COMPASS_AI_MODE=off

# Server-side only. Never expose this as a VITE_* variable.
OPENROUTER_API_KEY=

# Preview mode disables production provider calls and keeps the app deterministic.
VITE_INNER_COMPASS_PREVIEW=true

# Optional TEST-ONLY key used by /api/eval/guidance for AI Studio evaluation.
# It is not used by the production /api/guidance path.
GEMINI_API_KEY=
